{
  "name": "gateway-inference",
  "root": "packages/gateway-inference",
  "sourceRoot": "packages/gateway-inference/src",
  "targets": {
    "build": {
      "command": "pnpm --filter @sqgateway/inference build",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "command": "pnpm --filter @sqgateway/inference test",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/vitest.config.*", "{projectRoot}/package.json"],
      "cache": true
    },
    "lint": {
      "command": "pnpm --filter @sqgateway/inference lint",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/biome.json", "{projectRoot}/package.json"],
      "cache": true
    },
    "typecheck": {
      "command": "pnpm --filter @sqgateway/inference typecheck",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json"],
      "cache": true
    }
  }
}
