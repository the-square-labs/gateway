{
  "name": "@wiolett/gateway-installer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gateway-installer": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/cli.js && chmod 755 dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
