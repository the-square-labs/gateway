{
  "name": "@wiolett/gateway",
  "version": "0.1.0",
  "description": "Command-line companion for Wiolett Gateway",
  "type": "module",
  "bin": {
    "gateway": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.wiolett.net/wiolett/gateway.git",
    "directory": "packages/gateway-cli"
  },
  "bugs": {
    "url": "https://gitlab.wiolett.net/wiolett/gateway/-/issues"
  },
  "homepage": "https://gitlab.wiolett.net/wiolett/gateway",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --external:@napi-rs/keyring-* --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' && chmod 755 dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^22.10.5",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vite": "7.3.5",
    "vitest": "^4.1.5"
  }
}
